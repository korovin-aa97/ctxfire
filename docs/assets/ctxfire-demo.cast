[0.0,"o","\u001b[2J\u001b[H\u001b[1;38;5;208mctxfire: explain the static context graph\u001b[0m\r\n\r\n"]
[1.0,"o","\u001b[1;37m$ ctxfire explain --config examples/ctxfire-self.toml --agent implementer --file AGENTS.md\u001b[0m\r\n"]
[1.8,"o","ctxfire explain\r\nNo file contents were read or printed.\r\nByte sizes are exact; token figures are estimates.\r\nAssumptions: byte-estimate (approximation-v1), 4 bytes/token, model unspecified, price date unspecified, cache no-cache-credit.\r\n\r\nimplementer [codex@1]\r\n  AGENTS.md: 4710 exact bytes, ~1178 tokens, always at 100% — codex@1 instruction chain precedence (AGENTS.md)\r\n"]
[5.2,"o","\u001b[2J\u001b[H"]
[5.4,"o","\u001b[1;38;5;208mctxfire: compare two graph snapshots\u001b[0m\r\n\r\n"]
[6.2,"o","\u001b[1;37m$ ctxfire scan --config examples/demo/before.toml --format json --output before.json\u001b[0m\r\n"]
[7.2,"o","\u001b[1;32m[ok] baseline graph captured\u001b[0m\r\n"]
[8.0,"o","\u001b[1;37m$ ctxfire scan --config examples/demo/after.toml --format json --output after.json\u001b[0m\r\n"]
[9.0,"o","\u001b[1;32m[ok] changed graph captured\u001b[0m\r\n\r\n"]
[9.8,"o","\u001b[1;37m$ ctxfire diff before.json after.json\u001b[0m\r\n"]
[10.6,"o","ctxfire diff\r\nEstimated token deltas use each snapshot's recorded assumptions.\r\n\r\nimplementer: -1104 estimated tokens/day\r\n  - docs/legacy-handbook.md\r\n"]
[14.0,"o","\r\n\u001b[38;5;110mExact bytes. Explicit assumptions. Local only.\u001b[0m\r\n"]
